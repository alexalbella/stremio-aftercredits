{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "stremio-aftercredits",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-18",
  "workers_dev": true,
  "assets": {
    "directory": "./static",
    "binding": "ASSETS"
  },
  "kv_namespaces": [
    {
      "binding": "CACHE",
      "id": "1782c622d11e4cf08971cb299ef5de8f"
    }
  ],
  "observability": {
    "enabled": true,
    "traces": { "enabled": true }
  }
}
